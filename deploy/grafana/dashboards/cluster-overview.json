      "title": "Backend Target Health Status (1 = Up, 0 = Down)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "proxy_cluster_backend_health_status",
